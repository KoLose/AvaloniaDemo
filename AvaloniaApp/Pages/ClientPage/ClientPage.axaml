<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="AvaloniaApp.Pages.ClientPage.ClientPage"
        Title="ClientPage">
    <Grid RowDefinitions="Auto, *" >
        <Border Grid.Row="0" Background="Brown" Height="50">
            <StackPanel Orientation="Horizontal" Spacing="20" Margin="20,0,0,0">
                <Button Click="Create" Foreground="White">Создать заявку</Button>
                <Button Click="Get" Foreground="White">Посмотреть заявки</Button>
            </StackPanel>
        </Border>
        <Border Grid.Row="1" Background="DarkGray">
            <ContentControl x:Name="MainContent"/>
        </Border>
    </Grid>
</Window>
