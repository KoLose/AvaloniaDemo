<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="AvaloniaApp.Pages.ClientPage.ClientUC.CreateRequestUC">
    <Border Background="White">
        <StackPanel HorizontalAlignment="Center" Spacing="10" Margin="0 20 0 0">
            <TextBlock Text="Регистрация заявки" TextAlignment="Center"></TextBlock>
        <TextBox PlaceholderText="Серийный номер" Width="300"></TextBox>
        <TextBox PlaceholderText="Описание" Width="300"></TextBox>
        
</StackPanel>
    </Border>
</UserControl>
