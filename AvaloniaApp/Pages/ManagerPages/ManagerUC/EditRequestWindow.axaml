<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AvaloniaApp.Pages.ManagerPages.ManagerUC.EditRequestWindow"
        Title="Редактирование заявки" Width="400" Height="300" WindowStartupLocation="CenterOwner">
    <StackPanel Margin="15" Spacing="10">
        <TextBlock Text="Серийный номер:"/>
        <TextBox x:Name="SerialBox"/>
        
        <TextBlock Text="Тип заявки:"/>
        <ComboBox x:Name="TypeBox">
            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate>
        </ComboBox>
        
        <TextBlock Text="Механик:"/>
        <ComboBox x:Name="MechBox">
            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Login}"/></DataTemplate></ComboBox.ItemTemplate>
        </ComboBox>

        <Button Content="Сохранить" Click="Save" Margin="0,10,0,0"/>
    </StackPanel>
</Window>