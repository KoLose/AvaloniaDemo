<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AvaloniaApp.Pages.MechaPages.MechaUC.RequestUC">
    <DataGrid x:Name="Grid" 
              Margin="10" 
              IsReadOnly="True" 
              AutoGenerateColumns="False"
              DoubleTapped="OnDoubleTapped">
        <DataGrid.Columns>
            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
            <DataGridTextColumn Header="Клиент" Binding="{Binding Client.Login}" Width="120"/>
            <DataGridTextColumn Header="Серийный №" Binding="{Binding SerialNumber}" Width="80"/>
            <DataGridTextColumn Header="Тип" Binding="{Binding TypeNavigation.Name}" Width="120"/>
            <DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="*"/>
            <DataGridTextColumn Header="Этап" Binding="{Binding Stage.Name}" Width="100"/>
        </DataGrid.Columns>
    </DataGrid>
</UserControl>